# Copiar a .env (no commitear .env)

# Core
NODE_ENV=development
PORT=5007
DATABASE_URL=postgresql://postgres:postgres@localhost:5450/boardflow

# Auth (JWT + bcrypt)
JWT_SECRET=change-me-dev
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# App base URL (para links de email)
APP_URL=http://localhost:5007

# SMTP (invitaciones, reset de password)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-responder
MAIL_PASSWORD=
MAIL_FROM_NAME=BoardFlow
MAIL_FROM_ADDRESS=no-reply@example.com
